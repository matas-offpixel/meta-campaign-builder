@@ -0,0 +1,47 @@
+import { strict as assert } from "node:assert";
+import { test } from "node:test";
+
+import { adAccountMatchesAny, adAccountMatchesClient } from "../ad-account-match.ts";
+
+// `verifyAdAccountAllowedForThumbnail` itself calls Meta, so the unit
+// under test here is the pure matcher it delegates to.
+const matchesAny = adAccountMatchesAny;
+
+test("adAccountMatchesClient normalises the act_ prefix on either side", () => {
+  assert.equal(adAccountMatchesClient("606252931141334", "act_606252931141334"), true);
+  assert.equal(adAccountMatchesClient("act_606252931141334", "606252931141334"), true);
+  assert.equal(adAccountMatchesClient("act_606252931141334", "act_606252931141334"), true);
+});
+
+test("adAccountMatchesClient rejects a different account", () => {
+  // The real pair behind the bug: Electric Brixton's client default is
+  // ELECTRIC STUDIOS SHEFFIELD, but the NX Newcastle ads live in NX
+  // Promoter. Checking only the default 403'd every NX thumbnail.
+  assert.equal(
+    adAccountMatchesClient("606252931141334", "1073273492854557"),
+    false,
+  );
+});
+
+test("adAccountMatchesClient rejects null on either side", () => {
+  assert.equal(adAccountMatchesClient(null, "act_123"), false);
+  assert.equal(adAccountMatchesClient("act_123", null), false);
+  assert.equal(adAccountMatchesClient(undefined, undefined), false);
+});
+
+test("an ad in a per-event override account is allowed", () => {
+  // client default + the NX Promoter override pulled from events.
+  const allowed = ["1073273492854557", "606252931141334"];
+  assert.equal(matchesAny("606252931141334", allowed), true);
+  assert.equal(matchesAny("1073273492854557", allowed), true);
+});
+
+test("an ad in an unrelated account is still rejected", () => {
+  // Widening the set must not turn the check into a rubber stamp.
+  assert.equal(matchesAny("999999999999999", ["1073273492854557", "606252931141334"]), false);
+});
+
+test("an empty or all-null allowed set rejects everything", () => {
+  assert.equal(matchesAny("606252931141334", []), false);
+  assert.equal(matchesAny("606252931141334", [null, undefined, "  "]), false);
+});
diff --git a/lib/meta/ad-account-match.ts b/lib/meta/ad-account-match.ts
new file mode 100644
index 0000000..cd19d20
--- /dev/null
+++ b/lib/meta/ad-account-match.ts
@@ -0,0 +1,63 @@
+/**
+ * lib/meta/ad-account-match.ts
+ *
+ * Ad-account identity comparison for the creative-thumbnail proxy's
+ * authorisation check.
+ *
+ * Split out of `thumbnail-proxy-server.ts` — which carries
+ * `import "server-only"` and so cannot be loaded by Node's
+ * `--experimental-strip-types` test runner — for the same reason as
+ * `lib/meta/retry.ts` and `lib/meta/error-classify.ts`: the logic worth
+ * testing stays importable on its own.
+ *
+ * Why the multi-id form exists: a client is not one ad account.
+ * `clients.meta_ad_account_id` is the DEFAULT and
+ * `events.meta_ad_account_id` overrides it per event. Electric Brixton
+ * runs Mall Grab out of ELECTRIC STUDIOS SHEFFIELD and four NX
+ * Newcastle shows out of NX Promoter. Comparing an ad against the
+ * client default alone rejected every thumbnail belonging to an
+ * overridden event with a 403, which the dashboard rendered as a blank
+ * initials tile — indistinguishable from "Meta has no thumbnail for
+ * this ad".
+ */
+
+import { withoutActPrefix } from "./ad-account-id.ts";
+
+export function normalizeMetaAdAccountId(
+  raw: string | null | undefined,
+): string | null {
+  if (raw == null || typeof raw !== "string") return null;
+  const t = raw.trim();
+  if (!t) return null;
+  return withoutActPrefix(t);
+}
+
+/** Compare Graph `account_id` (may be `act_…` or digits) to stored client id. */
+export function adAccountMatchesClient(
+  graphAccountId: string | null | undefined,
+  clientAdAccountId: string | null | undefined,
+): boolean {
+  if (!graphAccountId || !clientAdAccountId) return false;
+  return (
+    normalizeMetaAdAccountId(graphAccountId) ===
+    normalizeMetaAdAccountId(clientAdAccountId)
+  );
+}
+
+/**
+ * True when the Graph account matches ANY id the client legitimately
+ * advertises from.
+ *
+ * Empty / all-blank sets return false: widening the check to a set must
+ * never degrade into "allow anything" when the set fails to populate.
+ */
+export function adAccountMatchesAny(
+  graphAccountId: string | null | undefined,
+  allowedAdAccountIds: ReadonlyArray<string | null | undefined>,
+): boolean {
+  const ids = allowedAdAccountIds.filter(
+    (id): id is string => typeof id === "string" && id.trim().length > 0,
+  );
+  if (ids.length === 0) return false;
+  return ids.some((id) => adAccountMatchesClient(graphAccountId, id));
+}
