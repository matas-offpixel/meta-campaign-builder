@@ -201,3 +220,40 @@ export async function handleCreativeThumbnailGet(
     return placeholderResponse(fallbackLabel);
   }
 }
+
+/**
+ * Every Meta ad account this client legitimately advertises from: the
+ * client default plus any per-event override.
+ *
+ * Ownership has already been proven by the caller (session or share
+ * token) before this runs, so reading the client's own event rows adds
+ * no new trust. A failed lookup degrades to the client default rather
+ * than throwing — a missing override should narrow what renders, never
+ * break the whole panel.
+ */
+async function loadClientAdAccountIds(
+  admin: ReturnType<typeof createServiceRoleClient>,
+  clientId: string | null,
+  clientDefault: string | null,
+): Promise<string[]> {
+  const ids = new Set<string>();
+  if (clientDefault?.trim()) ids.add(clientDefault.trim());
+  if (!clientId) return [...ids];
+
+  const { data, error } = await admin
+    .from("events")
+    .select("meta_ad_account_id")
+    .eq("client_id", clientId)
+    .not("meta_ad_account_id", "is", null);
+  if (error) {
+    console.warn(
+      `[creative-thumbnail-get] event ad account lookup failed: ${error.message}`,
+    );
+    return [...ids];
+  }
+  for (const row of (data ?? []) as Array<{ meta_ad_account_id: string | null }>) {
+    const id = row.meta_ad_account_id?.trim();
+    if (id) ids.add(id);
+  }
+  return [...ids];
+}
